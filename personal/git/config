[user]
	name = Nick Willett-Jeffries
	email = nwillettjeffries@gmail.com
[alias]
	smartlog = log --graph --pretty=format:'commit: %C(bold red)%h%Creset %C(red)[%H]%Creset %C(bold magenta)%d %Creset%ndate: %C(bold yellow)%cd %Creset%C(yellow)%cr%Creset%nauthor: %C(bold blue)%an%Creset %C(blue)[%ae]%Creset%n%C(cyan)%s%n%Creset'
[init]
	defaultBranch = main
[branch]
	sort = -committerdate
[push]
	autosetupremote = true
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = default
[fetch]
	prune = true
	pruneTags = true
[rerere]
	enabled = true
[rebase]
	autostash = true
	autosquash = true
	updateRefs = true
[help]
	autocorrect = prompt
[column]
	ui = auto
[tag]
	sort = version:refname
[url "git@github.com:"]
  insteadOf = "https://github.com/"
